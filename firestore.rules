rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dados de cada usuário: só o próprio dono lê e escreve
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /months/{month} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Catálogo de casas clones: todo usuário logado lê, só administradores editam
    match /catalog/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Lista de administradores: criada pelo console do Firebase, nunca pelo site
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
